# Copy this file to .env.local at the monorepo root and fill in your own values.
# .env.local is gitignored - your keys never touch the repo.
#
# IMPORTANT: this file goes at the MONOREPO ROOT, not in apps/extension/.
# Reason: apps/extension/vite.config.ts has `envDir: '../../'` which tells
# Vite to load .env files from the monorepo root, not the package directory.
#
# RPC URLs:
#   - Vite exposes any VITE_-prefixed var to client code via import.meta.env
#   - The extension SW reads VITE_ETH_RPC_URL via apps/extension/src/background/rpc-adapter.ts
#   - If left blank or removed, the extension falls back to https://cloudflare-eth.com (public, no key)
#
# Get an Alchemy key:
#   https://dashboard.alchemy.com -> create app for "Ethereum Mainnet" -> View Key -> copy HTTPS URL
# Or Infura:
#   https://app.infura.io -> create project -> Endpoints -> Ethereum -> copy HTTPS URL

VITE_ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY_HERE