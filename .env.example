# Copy this file to .env.local at the monorepo root and fill in your own values.
# .env.local is gitignored - your keys never touch the repo.
#
# IMPORTANT: this file goes at the MONOREPO ROOT, not in apps/extension/.
# Reason: apps/extension/vite.config.ts has `envDir: '../../'` which tells
# Vite to load .env files from the monorepo root, not the package directory.
#
# RPC URLs:
#   - Vite exposes any VITE_-prefixed var to client code via import.meta.env
#   - The extension SW reads VITE_ETH_RPC_URL via apps/extension/src/background/rpc-adapter.ts
#   - If left blank or removed, the extension falls back to https://cloudflare-eth.com (public, no key)
#
# Get an Alchemy key:
#   https://dashboard.alchemy.com -> create app for "Ethereum Mainnet" -> View Key -> copy HTTPS URL
# Or Infura:
#   https://app.infura.io -> create project -> Endpoints -> Ethereum -> copy HTTPS URL

VITE_ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY_HERE

# ─────────────────────────────────────────────────────────────────────────────
# DeFi & on-ramp protocols (this is a TEMPLATE — wire your own infrastructure)
# ─────────────────────────────────────────────────────────────────────────────
#
# Lending (Aave V3), Swap (Velora), and Bridge (USDT0) need NO keys — they run
# on the public RPCs above and the providers' public APIs. Nothing to set.
#
# ERC-4337 smart accounts / gasless: supply your own bundler (and optionally a
# paymaster for sponsored / pay-gas-in-token transactions). Until set, the
# Smart Account view shows a "configure" notice; the integration is fully wired.
#   Get a bundler/paymaster: Pimlico (https://pimlico.io), Stackup
#   (https://stackup.sh), Candide, Alchemy AA, Biconomy, etc.
# VITE_BUNDLER_URL=https://api.pimlico.io/v2/ethereum/rpc?apikey=YOUR_KEY
# VITE_PAYMASTER_URL=https://api.pimlico.io/v2/ethereum/rpc?apikey=YOUR_KEY
#
# MoonPay fiat on-ramp: supply your own PUBLISHABLE key (safe for the client).
# For production, MoonPay requires URL signing with your SECRET key — host a tiny
# backend endpoint (POST { urlForSignature } -> { signedUrl }) and point
# VITE_MOONPAY_SIGN_URL at it. Defaults to MoonPay 'sandbox' (test funds).
#   Get a key: https://dashboard.moonpay.com -> Developers -> API keys
# VITE_MOONPAY_API_KEY=pk_test_YOUR_PUBLISHABLE_KEY
# VITE_MOONPAY_ENV=sandbox
# VITE_MOONPAY_SIGN_URL=https://your-backend.example.com/moonpay/sign-url